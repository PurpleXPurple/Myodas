{
  "manifest_version": 3,
  "name": "DeepSeek Prompt Nexus",
  "version": "12.0.0",
  "description": "Skills, Prompts, Theming, and Real Token Counting — fully offline tokenizer, account-token API access via the service worker.",

  "permissions": ["storage"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://huggingface.co/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "classic"
  },

  "action": {
    "default_title": "Prompt Nexus",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": [
        "src/shared/constants.js",
        "src/shared/util.js",
        "src/shared/storage.js",
        "src/shared/tokenizer.js",
        "src/shared/api-client.js",
        "src/shared/theme-engine.js",
        "src/content/composer.js",
        "src/content/slash.js",
        "src/content/tokens.js",
        "src/content/panel.js",
        "src/content/main.js"
      ],
      "css": ["content.css"],
        "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["src/content/interceptor.js", "data/*.json"],
      "matches": ["https://chat.deepseek.com/*"]
    }
  ]
}
